{
  "source": {
    "repository": "https://github.com/earendil-works/pi",
    "ref": "main",
    "script": "/ts-parity/bedrock-fixture.ts"
  },
  "provider": "amazon-bedrock",
  "auth": "payload-only",
  "payload": {
    "modelId": "us.anthropic.claude-opus-4-6-v1",
    "messages": [
      {
        "role": "user",
        "content": [
          {
            "text": "hello"
          },
          {
            "cachePoint": {
              "type": "default"
            }
          }
        ]
      }
    ],
    "system": [
      {
        "text": "pi rust cli"
      },
      {
        "cachePoint": {
          "type": "default"
        }
      }
    ],
    "inferenceConfig": {},
    "toolConfig": {
      "tools": [
        {
          "toolSpec": {
            "name": "fixture_echo",
            "description": "Echo text for the parity fixture.",
            "inputSchema": {
              "json": {
                "type": "object",
                "required": [
                  "text"
                ],
                "properties": {
                  "text": {
                    "type": "string"
                  }
                }
              }
            }
          }
        }
      ]
    },
    "additionalModelRequestFields": {
      "thinking": {
        "type": "adaptive",
        "display": "summarized"
      },
      "output_config": {
        "effort": "max"
      }
    }
  }
}
