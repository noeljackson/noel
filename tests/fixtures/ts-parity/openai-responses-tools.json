{
  "source": {
    "repository": "https://github.com/earendil-works/pi",
    "ref": "main",
    "script": "/ts-parity/openai-tools-fixture.ts"
  },
  "provider": "openai",
  "auth": "api-key",
  "request": {
    "url": "https://api.openai.com/v1/responses",
    "method": "POST",
    "headers": {
      "accept": "application/json",
      "authorization": "Bearer <redacted>",
      "content-type": "application/json",
      "user-agent": "OpenAI/JS 6.26.0",
      "x-stainless-arch": "x64",
      "x-stainless-lang": "js",
      "x-stainless-os": "Linux",
      "x-stainless-package-version": "6.26.0",
      "x-stainless-retry-count": "0",
      "x-stainless-runtime": "node",
      "x-stainless-runtime-version": "v24.16.0"
    },
    "body": {
      "model": "gpt-5.4",
      "input": [
        {
          "role": "developer",
          "content": "pi rust cli"
        },
        {
          "role": "user",
          "content": [
            {
              "type": "input_text",
              "text": "hello"
            }
          ]
        }
      ],
      "stream": true,
      "store": false,
      "max_output_tokens": 128000,
      "tools": [
        {
          "type": "function",
          "name": "fixture_echo",
          "description": "Echo text for the parity fixture.",
          "parameters": {
            "type": "object",
            "required": [
              "text"
            ],
            "properties": {
              "text": {
                "type": "string"
              }
            }
          },
          "strict": false
        }
      ],
      "reasoning": {
        "effort": "xhigh",
        "summary": "auto"
      },
      "include": [
        "reasoning.encrypted_content"
      ]
    }
  }
}
