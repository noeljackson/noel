    {
      "name": "pty",
      "description": "pty with started and raw output events; ptyResize, ptyForeground, ptyWrite; EBADF once it has ended",
      "steps": [
        {
          "send": {
            "type": "request",
            "id": 1,
            "json": {
              "protocol": 1,
              "op": "hello"
            }
          }
        },
        {
          "receive": {
            "type": "result",
            "id": 1,
            "json": {
              "arch": "<arch>",
              "cwd": "<cwd>",
              "driveCwds": {},
              "features": [
                "listFiles"
              ],
              "home": "<home>",
              "os": "<os>",
              "pid": "<pid>",
              "protocol": 1,
              "separator": "/",
              "tmpdir": "<tmpdir>",
              "version": "<version>"
            }
          }
        },
        {
          "send": {
            "type": "request",
            "id": 2,
            "json": {
              "cwd": "<root>",
              "argv": [
                "sh",
                "-c",
                "IFS= read -r line; printf \"got %s\\n\" \"$line\"; exit 3"
              ],
              "env": {
                "TERM": "dumb"
              },
              "cols": 80,
              "rows": 24,
              "op": "pty"
            }
          }
        },
        {
          "receive": {
            "type": "event",
            "id": 2,
            "json": {
              "kind": "started",
              "pid": "<pid>"
            }
          }
        },
        {
          "send": {
            "type": "request",
            "id": 3,
            "json": {
              "target": 2,
              "cols": 100,
              "rows": 30,
              "op": "ptyResize"
            }
          }
        },
        {
          "receive": {
            "type": "result",
            "id": 3,
            "json": {}
          }
        },
        {
          "send": {
            "type": "request",
            "id": 4,
            "json": {
              "target": 2,
              "op": "ptyForeground"
            }
          }
        },
        {
          "receive": {
            "type": "result",
            "id": 4,
            "json": {
              "foreground": null
            }
          }
        },
        {
          "send": {
            "type": "request",
            "id": 5,
            "json": {
              "target": 2,
              "op": "ptyWrite"
            },
            "payload": {
              "utf8": "abc\n"
            }
          }
        },
        {
          "receive": {
            "type": "result",
            "id": 5,
            "json": {}
          }
        },
        {
          "receive": {
            "type": "event",
            "id": 2,
            "json": {
              "kind": "output"
            },
            "payload": {
              "utf8": "abc\r\ngot abc\r\n"
            }
          }
        },
        {
          "receive": {
            "type": "result",
            "id": 2,
            "json": {
              "exitCode": 3
            }
          }
        },
        {
          "send": {
            "type": "request",
            "id": 6,
            "json": {
              "target": 2,
              "op": "ptyWrite"
            },
            "payload": {
              "utf8": "late\n"
            }
          }
        },
        {
          "receive": {
            "type": "error",
            "id": 6,
            "json": {
              "code": "EBADF",
              "message": "no running terminal with this id"
            }
          }
        },
        {
          "send": {
            "type": "request",
            "id": 7,
            "json": {
              "target": 2,
              "op": "ptyForeground"
            }
          }
        },
        {
          "receive": {
            "type": "error",
            "id": 7,
            "json": {
              "code": "EBADF",
              "message": "no running terminal with this id"
            }
          }
        }
      ]
    },
    {
      "name": "watch",
      "description": "watch: ready, a change for a written file, and the result once cancelled",
      "steps": [
        {
          "send": {
            "type": "request",
            "id": 1,
            "json": {
              "protocol": 1,
              "op": "hello"
            }
          }
        },
        {
          "receive": {
            "type": "result",
            "id": 1,
            "json": {
              "arch": "<arch>",
              "cwd": "<cwd>",
              "driveCwds": {},
              "features": [
                "listFiles"
              ],
              "home": "<home>",
              "os": "<os>",
              "pid": "<pid>",
              "protocol": 1,
              "separator": "/",
              "tmpdir": "<tmpdir>",
              "version": "<version>"
            }
          }
        },
        {
          "send": {
            "type": "request",
            "id": 2,
            "json": {
              "targets": [
                {
                  "path": "<root>",
                  "recursive": true,
                  "exclude": {
                    "hidden": false,
                    "names": []
                  }
                }
              ],
              "op": "watch"
            }
          }
        },
        {
          "receive": {
            "type": "event",
            "id": 2,
            "json": {
              "kind": "ready",
              "mode": "native"
            }
          }
        },
        {
          "send": {
            "type": "request",
            "id": 3,
            "json": {
              "path": "<root>/w.txt",
              "append": false,
              "keep": false,
              "op": "write"
            },
            "payload": {
              "utf8": "w"
            }
          }
        },
        {
          "receive": {
            "type": "result",
            "id": 3,
            "json": {}
          }
        },
        {
          "receive": {
            "type": "event",
            "id": 2,
            "json": {
              "kind": "change",
              "paths": [
                "<root>/w.txt"
              ]
            }
          }
        },
        {
          "send": {
            "type": "cancel",
            "id": 2,
            "json": {}
          }
        },
        {
          "receive": {
            "type": "result",
            "id": 2,
            "json": {}
          }
        }
      ]
    },
    {
      "name": "liveness",
      "description": "hello, then a ping each way (both sides ping every 5 s)",
      "steps": [
        {
          "send": {
            "type": "request",
            "id": 1,
            "json": {
              "protocol": 1,
              "op": "hello"
            }
          }
        },
        {
          "receive": {
            "type": "result",
            "id": 1,
            "json": {
              "arch": "<arch>",
              "cwd": "<cwd>",
              "driveCwds": {},
              "features": [
                "listFiles"
              ],
              "home": "<home>",
              "os": "<os>",
              "pid": "<pid>",
              "protocol": 1,
              "separator": "/",
              "tmpdir": "<tmpdir>",
              "version": "<version>"
            }
          }
        },
        {
          "send": {
            "type": "ping",
            "id": 0,
            "json": {}
          }
        },
        {
          "receive": {
            "type": "ping",
            "id": 0,
            "json": {}
          }
        }
      ]
    }
  ]
}
