# Pinned toolchain for `make check-ci`. Keep the tag in sync with rust-toolchain.toml
# and the dtolnay/rust-toolchain ref in .github/workflows.
FROM rust:1.99.0

RUN rustup component add clippy rustfmt \
    && apt-get update \
    && apt-get install -y --no-install-recommends tmux \
    && rm -rf /var/lib/apt/lists/*
