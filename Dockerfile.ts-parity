FROM node:24-bookworm

RUN apt-get update \
    && apt-get install -y --no-install-recommends git ca-certificates \
    && rm -rf /var/lib/apt/lists/*

ARG TS_REFERENCE_REPO=https://github.com/earendil-works/pi.git
ARG TS_REFERENCE_REF=main

RUN git clone --filter=blob:none "${TS_REFERENCE_REPO}" /ts-reference \
    && cd /ts-reference \
    && git checkout "${TS_REFERENCE_REF}"

WORKDIR /ts-reference
RUN npm ci --ignore-scripts
RUN npm --prefix packages/ai run generate-models

COPY scripts/ts-parity /ts-parity

CMD ["sh", "-c", "for fixture in /ts-parity/*-fixture.ts; do npx tsx \"$fixture\" /fixtures; done"]
